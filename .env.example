# ========================================================
# GapCheck Environment Configuration Template
# Copy this file to .env in production / local environments.
# DO NOT commit real secrets or credentials to source control.
# ========================================================

# --------------------------------------------------------
# BACKEND (Render Web Service / apps/api)
# --------------------------------------------------------

# Environment mode ('production', 'development', or 'test')
NODE_ENV=production

# Server Port (Render automatically sets PORT in production; defaults to 3001)
PORT=3001

# Production PostgreSQL Database Connection URL
# Examples:
#   Managed Postgres on Render: postgresql://user:password@dpg-xxxxx.oregon-postgres.render.com/gapcheck_db
#   Local development fallback: (leave empty or use default to use local persistent PGlite)
DATABASE_URL=postgresql://user:password@localhost:5432/gapcheck

# JSON Web Token Secret (Required in production: use 32+ random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key

# JWT Token Lifespan (e.g., '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
# In production, set to your deployed Vercel domain(s):
FRONTEND_URL=https://gapcheck.vercel.app

# GitHub API Personal Access Token (Optional: Increases rate limit from 60/hr to 5000/hr)
# Never prefix with NEXT_PUBLIC; keep strictly on the backend.
GITHUB_TOKEN=

# LLM API Configuration (OpenAI or compatible provider)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# --------------------------------------------------------
# FRONTEND (Vercel / apps/web)
# --------------------------------------------------------

# URL of the deployed Express backend API (e.g., on Render)
# Local development default: http://localhost:3001
NEXT_PUBLIC_API_URL=https://gapcheck-api.onrender.com
